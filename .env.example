# Bike Garage connects to the local Strava Proxy; it does not hold Strava OAuth credentials.
# Set registration to true only while creating or replacing the one passkey.
BIKE_GARAGE_PASSKEY_REGISTRATION_ENABLED=false
# Keep sessions valid across container restarts.
BIKE_GARAGE_SESSION_SECRET=
# Required on a NAS behind HTTPS (the RP ID is the hostname, without https://).
# BIKE_GARAGE_PASSKEY_RP_ID=bike-garage.example.net
# BIKE_GARAGE_PASSKEY_ORIGIN=https://bike-garage.example.net
# BIKE_GARAGE_PUBLIC_ORIGIN=https://bike-garage.example.net
