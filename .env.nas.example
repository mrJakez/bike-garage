# Copy to .env next to compose.ghcr.yaml, then replace the placeholder values.
SYNC_INTERVAL_SECONDS=300

# Set true only while creating or deliberately replacing the one passkey.
BIKE_GARAGE_PASSKEY_REGISTRATION_ENABLED=true
BIKE_GARAGE_SESSION_SECRET=replace-with-a-long-random-secret
BIKE_GARAGE_PASSKEY_RP_ID=bike-garage.example.net
BIKE_GARAGE_PASSKEY_ORIGIN=https://bike-garage.example.net
